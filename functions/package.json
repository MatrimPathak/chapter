{
  "name": "chapter-functions",
  "private": true,
  "description": "Chapter Cloud Functions (catalog providers arrive in Phase 3, account deletion in Phase 8).",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src",
    "test:rules": "vitest run --dir test/rules",
    "test:integration": "vitest run --dir test/integration",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-chapter \"npm run test:rules && npm run test:integration\"",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@firebase/rules-unit-testing": "^4.0.0",
    "eslint": "^9.0.0",
    "firebase": "^11.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
